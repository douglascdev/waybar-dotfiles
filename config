{
    "layer": "top",
    "position": "top",
    "modules-left": ["hyprland/workspaces", "custom/media"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["custom/todolist", "cpu", "memory", "disk", "wireplumber", "clock", "custom/quit"],
    "clock": {
        "format": "  {:%H:%M}",
        "format-alt": "{:%a %b %d}",
        "tooltip": false
    },
    "hyprland/window": {  
        "max-length": 50
    },
    "hyprland/workspaces": {
        "all-outputs": false,
        "format": "{name}: {icon} ",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "🎮",
            "4": "",
            "5": "",
            "urgent": "",
            "default": "",
        },
    },
    "cpu": {
        "interval": 5,
        "format": "  {usage}% ",
        "max-length": 10
    },
    "disk": {
	    "interval": 30,
	    "format": "🖪 {percentage_used}%",
    },
    "memory": {
        "interval": 30,
        "format": "  {}%"
    },
    "network": {
        "format": "{ifname}",
        "format-wifi": " {essid}",
        "format-ethernet": " {ifname}",
        "format-disconnected": "",
        "tooltip-format-wifi": "{signalStrength}%",
        "max-length": 20
    },
    "custom/media": {
        "format": "{}",
        "interval": 1,
        "max-length": 50,
        "exec": "$HOME/.config/waybar/get_media.sh"
    },
    "custom/todolist": {
        "format": "{}",
        "interval": 5,
        "exec": "python $HOME/.config/waybar/todo.py status",
        "on-click": "python $HOME/.config/waybar/todo.py pop"
    },
    "wireplumber": {
        "format": "{icon}  {volume}%",
        "format-bluetooth": "{icon} {volume}%",
        "format-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", ""]
        },
        "scroll-step": 1,
        "on-click": "pavucontrol"
    },
    "custom/quit": {
        "format": " ",
        "on-click": "hyprctl dispatch exit"
    }
}
